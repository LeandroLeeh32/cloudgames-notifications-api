{
  "rabbit_version": "3.13.0",
  "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator"
    }
  ],

  "vhosts": [
    {
      "name": "/"
    }
  ],

  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],

  "queues": [
    {
      "name": "PaymentProcessed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "UserCreated",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],

  "exchanges": [
    {
      "name": "FIAP.Messages:PaymentProcessedEvent",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "CloudGames.Notifications.Application.IntegrationEvents.Users:UserCreatedIntegrationEvent",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],

  "bindings": [
    {
      "source": "FIAP.Messages:PaymentProcessedEvent",
      "vhost": "/",
      "destination": "PaymentProcessed",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "CloudGames.Notifications.Application.IntegrationEvents.Users:UserCreatedIntegrationEvent",
      "vhost": "/",
      "destination": "UserCreated",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    }
  ]
}